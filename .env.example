# Copy this file to .env and adjust the values.

# PostgreSQL connection. This default matches `npm run db:dev`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/supershop

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Set when running behind a reverse proxy (e.g. nginx): "true", a hop count like 1, or an IP list.
TRUST_PROXY=

# Used by `npm run create-admin` to create (or reset) the admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port for the local development database started by `npm run db:dev`.
DEV_DB_PORT=5433
